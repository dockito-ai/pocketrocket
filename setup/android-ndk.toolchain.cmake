# Written by PocketRocket's Android NDK add-on (decisions 50 and 96). Stands in for the NDK's toolchain file on an arm64
# Android host: Termux's clang behind the NDK layout, four ABIs, every ANDROID_STL. The clang wrappers in bin/ add the
# sysroot, the resource dir and the linker that drops Termux's rpath.
get_filename_component(_NDK "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(_TC "${_NDK}/toolchains/llvm/prebuilt/linux-x86_64")

if(NOT ANDROID_ABI)
  set(ANDROID_ABI arm64-v8a)
endif()
if(ANDROID_ABI STREQUAL "arm64-v8a")
  set(_PROC aarch64)
  set(_TRIPLE aarch64-none-linux-android)
elseif(ANDROID_ABI STREQUAL "armeabi-v7a")
  set(_PROC armv7-a)
  set(_TRIPLE armv7-none-linux-androideabi)
elseif(ANDROID_ABI STREQUAL "x86")
  set(_PROC i686)
  set(_TRIPLE i686-none-linux-android)
elseif(ANDROID_ABI STREQUAL "x86_64")
  set(_PROC x86_64)
  set(_TRIPLE x86_64-none-linux-android)
else()
  message(FATAL_ERROR "PocketRocket's Android NDK add-on builds arm64-v8a, armeabi-v7a, x86 and x86_64; not ${ANDROID_ABI}.")
endif()
if(NOT ANDROID_PLATFORM)
  set(ANDROID_PLATFORM android-24)
endif()
string(REPLACE "android-" "" _API "${ANDROID_PLATFORM}")
if(NOT ANDROID_STL)
  set(ANDROID_STL c++_static) # Google's default
endif()

set(ANDROID TRUE)
set(CMAKE_SYSTEM_NAME Android)
set(CMAKE_SYSTEM_VERSION ${_API})
set(CMAKE_SYSTEM_PROCESSOR ${_PROC})
set(CMAKE_ANDROID_ARCH_ABI ${ANDROID_ABI})
set(ANDROID_NDK "${_NDK}")
# CMake's own Android platform files must not take over: we are a toolchain file, not an NDK it knows.
set(CMAKE_ANDROID_NDK "${_NDK}")
set(CMAKE_ANDROID_NDK_TOOLCHAIN_UNIFIED "${_TC}")

set(CMAKE_C_COMPILER "${_TC}/bin/clang")
set(CMAKE_CXX_COMPILER "${_TC}/bin/clang++")
set(CMAKE_ASM_COMPILER "${_TC}/bin/clang")
set(CMAKE_C_COMPILER_TARGET ${_TRIPLE}${_API})
set(CMAKE_CXX_COMPILER_TARGET ${_TRIPLE}${_API})
set(CMAKE_ASM_COMPILER_TARGET ${_TRIPLE}${_API})
set(CMAKE_AR "${_TC}/bin/llvm-ar" CACHE FILEPATH "")
set(CMAKE_RANLIB "${_TC}/bin/llvm-ranlib" CACHE FILEPATH "")
set(CMAKE_STRIP "${_TC}/bin/llvm-strip" CACHE FILEPATH "")
set(CMAKE_SYSROOT "${_TC}/sysroot")

set(CMAKE_FIND_ROOT_PATH "${_TC}/sysroot")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(_F "-DANDROID -fPIC -ffunction-sections -fdata-sections -funwind-tables -fstack-protector-strong -no-canonical-prefixes -D_FORTIFY_SOURCE=2 -Wformat -Werror=format-security")
if(ANDROID_ABI STREQUAL "armeabi-v7a" AND NOT ANDROID_ARM_MODE STREQUAL "arm")
  string(APPEND _F " -mthumb")
endif()
set(CMAKE_C_FLAGS_INIT "${_F}")
set(CMAKE_CXX_FLAGS_INIT "${_F}")
set(CMAKE_ASM_FLAGS_INIT "${_F}")
set(_L "-Wl,--build-id=sha1 -Wl,--no-undefined -Wl,-z,max-page-size=16384")
if(ANDROID_STL STREQUAL "c++_static")
  string(APPEND _L " -static-libstdc++")
elseif(ANDROID_STL STREQUAL "none")
  string(APPEND CMAKE_CXX_FLAGS_INIT " -nostdinc++")
  string(APPEND _L " -nostdlib++")
elseif(NOT ANDROID_STL STREQUAL "c++_shared" AND NOT ANDROID_STL STREQUAL "system")
  message(FATAL_ERROR "ANDROID_STL ${ANDROID_STL} is not one of c++_static, c++_shared, none, system.")
endif()
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_L}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${_L}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${_L}")

set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ANDROID_ABI ANDROID_PLATFORM ANDROID_STL ANDROID_ARM_MODE)
